# Archivos de texto con finales consistentes entre Windows y contenedores Linux.
* text=auto
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.http text eol=lf
*.md text eol=lf whitespace=-blank-at-eol
Dockerfile text eol=lf
*.ps1 text eol=crlf
*.png binary
