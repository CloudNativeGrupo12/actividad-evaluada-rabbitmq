# Configuracion de Perfil (local | cloud)
# 'local' usa H2 persistente. 'cloud' usa PostgreSQL
SPRING_PROFILES_ACTIVE=local

# Credenciales de Base de Datos (Fase 2) - Solo requeridas si SPRING_PROFILES_ACTIVE=cloud
# Mantener comentadas para local: Compose usa H2 cuando estas variables no existen.
# configurar-aws.ps1 e inicializar-postgres.py completan y activan cloud.
# Para una instancia existente, descomentar y completar las seis variables siguientes.
# RESERVAS_DB_URL=jdbc:postgresql://<tu-rds-endpoint>:5432/reservas?sslmode=require
# DISPONIBILIDAD_DB_URL=jdbc:postgresql://<tu-rds-endpoint>:5432/disponibilidad?sslmode=require
# NOTIFICACIONES_DB_URL=jdbc:postgresql://<tu-rds-endpoint>:5432/notificaciones?sslmode=require
# AUDITORIA_DB_URL=jdbc:postgresql://<tu-rds-endpoint>:5432/auditoria?sslmode=require
# DB_USER=<usuario-rds>
# DB_PASSWORD=<password-local-no-subir>

# Credenciales de Seguridad Azure Entra ID (Fase 3) - Requeridas SIEMPRE para que los MS inicien
AZURE_TENANT_ID=tu-tenant-id-aqui
AZURE_CLIENT_ID=tu-client-id-aqui
RABBIT_USER=reservas
RABBIT_PASSWORD=reservas-demo
CORS_ALLOWED_ORIGINS=http://localhost:4200
